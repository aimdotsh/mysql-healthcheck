# MySQL Healthcheck SaaS — 环境变量样例
# 拷贝到仓库根目录的 .env，docker compose 会自动加载。
#
# cp deploy/env.example .env
# vim .env
# docker compose up -d

# ============== 运行时 ==============
# 容器内服务端口（一般不用改）
# PORT=3000

# 宿主机暴露端口（默认 3000；与其它服务冲突时改这里）
HOST_PORT=3000

# 宿主机绑定地址（默认 127.0.0.1，强制走反代）
# 若想直接对外暴露（无 HTTPS / 无 nginx），改成 0.0.0.0
HOST_BIND=127.0.0.1

# 持久化数据宿主机路径（默认 /var/lib/mysql-healthcheck）
STORAGE_HOST_DIR=/var/lib/mysql-healthcheck

# ============== 上传限制 ==============
# 单次最多上传文件数
MAX_FILES=16

# 单文件最大体积（MB）；大集群多节点采集 txt 可能 > 50 MB
MAX_FILE_SIZE_MB=50

# ============== 鉴权（强烈建议生产开启）==============
# 不留空 → 所有 /api/v1/* 请求要带 Authorization: Bearer <key>
# 生成长随机：openssl rand -hex 32
API_KEY=

# ============== 时区（可选）==============
# 容器内默认 UTC，国内部署可改
# TZ=Asia/Shanghai
