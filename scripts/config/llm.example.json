{
  "_doc": "OpenAI-compatible 大模型辅助巡检示例。API Key 不写入文件，只从 apiKeyEnv 指定的环境变量读取。",
  "enabled": true,
  "provider": "openai-compatible",
  "baseUrl": "https://api.openai.com/v1",
  "endpoint": "chat/completions",
  "apiKeyEnv": "MYSQL_HC_LLM_API_KEY",
  "apiKeyHeader": "Authorization",
  "apiKeyPrefix": "Bearer ",
  "model": "your-model-name",
  "timeoutMs": 60000,
  "temperature": 0.1,
  "maxTokens": 3000,
  "maxFindings": 10,
  "jsonMode": true,
  "failOpen": true,
  "redactHosts": true,
  "includeSqlText": false,
  "scopes": [
    "availability",
    "performance",
    "durability",
    "security",
    "operations",
    "dataDesign"
  ]
}
