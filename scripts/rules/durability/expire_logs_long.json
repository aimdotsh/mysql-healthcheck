{
  "id": "expire_logs_long",
  "scope": "node",
  "priority": "P3",
  "title": "expire_logs_days 保留过长",
  "rationale": "保留过长会占用磁盘空间；评估业务回滚需求。",
  "trigger": "node.variables.expire_logs_days != '0' && node.variables.expire_logs_days > cfg.thresholds.binlog.expire_logs_max_days",
  "groupKeyTpl": "expire_logs_long:{{node.ip}}",
  "descriptionTpl": "expire_logs_days = {{node.variables.expire_logs_days}}（保留过长，> {{cfg.thresholds.binlog.expire_logs_max_days}} 天）",
  "actionTpl": "评估磁盘成本与回滚需求"
}
