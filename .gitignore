# macOS
.DS_Store
**/.DS_Store

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 依赖（preprocess.js 零依赖，仓库不应含 node_modules；
# 万一有人在仓库里 npm install 出 scripts/node_modules 之类，忽略掉）
node_modules/
**/node_modules/

# 打包产物（如 ykt_v2.0.zip 等，不入库）
*.zip

# pkg 二进制产物
dist/
mysql-healthcheck-linux-x64
package-lock.json

# 临时
*.tmp
*.bak
*~

# 运行产物（用户在数据目录里跑出的 markdown 报告）
# 不在此分支里，但万一有人在仓库目录里跑：
MySQL巡检报告_*.md
*_MySQL巡检报告_*.md
